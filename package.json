{
  "name": "env-phantom",
  "version": "0.1.1",
  "description": "Zero-knowledge .env proxy: phantom tokens in process.env, real secrets only at TLS edge for allowlisted hosts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "env-phantom": "./dist/cli.js"
  },
  "main": "./dist/bridge.js",
  "exports": {
    ".": "./dist/bridge.js",
    "./bridge": "./dist/bridge.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "jsr.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "publint": "^0.3.12",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "author": "Augusto Cerrutti <augustocerruttisatto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanchingyg/env-phantom.git"
  },
  "mcpName": "io.github.kanchingyg/env-phantom",
  "homepage": "https://github.com/kanchingyg/env-phantom#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "typescript",
    "security",
    "secrets",
    "dotenv",
    "proxy",
    "tls",
    "ai-agents",
    "secret-management"
  ]
}
